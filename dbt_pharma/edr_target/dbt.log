{"data": {"conn_name": "macro_log_macro_results", "sql": "with ordered_run_results as (\n      select\n        *,\n        row_number() over (partition by unique_id order by run_results.generated_at desc) as row_number\n      from PHARMA_DW_DEV.ELEMENTARY.dbt_run_results run_results\n      join PHARMA_DW_DEV.ELEMENTARY.dbt_models using (unique_id)\n    ),\n\n    latest_run_results as (\n      select *\n      from ordered_run_results\n      where row_number = 1\n    )\n\n    select unique_id, invocation_id from latest_run_results\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "9a5d53fe-d16c-41e3-984d-4955e9486e1a", "level": "debug", "msg": "On macro_log_macro_results: with ordered_run_results as (\n      select\n        *,\n        row_number() over (partition by unique_id order by run_results.generated_at desc) as row_number\n      from PHARMA_DW_DEV.ELEMENTARY.dbt_run_results run_results\n      join PHARMA_DW_DEV.ELEMENTARY.dbt_models using (unique_id)\n    ),\n\n    latest_run_results as (\n      select *\n      from ordered_run_results\n      where row_number = 1\n    )\n\n    select unique_id, invocation_id from latest_run_results\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */", "name": "SQLQuery", "pid": 32300, "thread": "MainThread", "ts": "2026-10-05T23:17:13.350956Z"}}
