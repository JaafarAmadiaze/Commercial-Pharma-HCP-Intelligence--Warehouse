, "schema": "ELEMENTARY"}, {"database": "PHARMA_DW_DEV", "identifier": "METRICS_ANOMALY_SCORE", "schema": "ELEMENTARY"}, {"database": "PHARMA_DW_DEV", "identifier": "MODEL_RUN_RESULTS", "schema": "ELEMENTARY"}, {"database": "PHARMA_DW_DEV", "identifier": "MONITORS_RUNS", "schema": "ELEMENTARY"}, {"database": "PHARMA_DW_DEV", "identifier": "SCHEMA_COLUMNS_SNAPSHOT", "schema": "ELEMENTARY"}, {"database": "PHARMA_DW_DEV", "identifier": "SEED_RUN_RESULTS", "schema": "ELEMENTARY"}, {"database": "PHARMA_DW_DEV", "identifier": "SNAPSHOT_RUN_RESULTS", "schema": "ELEMENTARY"}, {"database": "PHARMA_DW_DEV", "identifier": "TEST_RESULT_ROWS", "schema": "ELEMENTARY"}], "schema": "ELEMENTARY"}, "info": {"category": "", "code": "E014", "extra": {}, "invocation_id": "ab11793b-e3ce-470b-9ec9-0023dd44fccf", "level": "debug", "msg": "While listing relations in database=PHARMA_DW_DEV, schema=ELEMENTARY, found: ALERTS_ANOMALY_DETECTION, ALERTS_DBT_MODELS, ALERTS_DBT_SOURCE_FRESHNESS, ALERTS_DBT_TESTS, ALERTS_SCHEMA_CHANGES, ANOMALY_THRESHOLD_SENSITIVITY, DATA_MONITORING_METRICS, DBT_ARTIFACTS_HASHES, DBT_COLUMNS, DBT_EXPOSURES, DBT_INVOCATIONS, DBT_METRICS, DBT_MODELS, DBT_RUN_RESULTS, DBT_SEEDS, DBT_SNAPSHOTS, DBT_SOURCES, DBT_SOURCE_FRESHNESS_RESULTS, DBT_TESTS, ELEMENTARY_TEST_RESULTS, JOB_RUN_RESULTS, METADATA, METRICS_ANOMALY_SCORE, MODEL_RUN_RESULTS, MONITORS_RUNS, SCHEMA_COLUMNS_SNAPSHOT, SEED_RUN_RESULTS, SNAPSHOT_RUN_RESULTS, TEST_RESULT_ROWS", "name": "ListRelations", "pid": 8308, "thread": "MainThread", "ts": "2026-10-05T23:13:49.333096Z"}}
