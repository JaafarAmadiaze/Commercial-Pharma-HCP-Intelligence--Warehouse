an_id, territory_id\n),\n\nhcp_rx_summary AS (\n    SELECT\n        physician_id,\n        SUM(CASE WHEN is_our_brand THEN trx_count ELSE 0 END) AS our_brand_total_trx,\n        SUM(CASE WHEN is_our_brand THEN total_gross_rx_value ELSE 0 END) AS our_brand_revenue\n    FROM PHARMA_DW_DEV.MARTS.fact_prescription_claims\n    GROUP BY physician_id\n)\n\nSELECT\n    c.rep_id,\n    c.territory_id,\n    c.physician_id,\n    c.total_visits,\n    c.total_samples_provided,\n    ROUND(c.avg_sentiment_score, 3) AS avg_sentiment_score,\n    c.most_frequent_barrier,\n    COALESCE(rx.our_brand_total_trx, 0) AS our_brand_total_trx,\n    COALESCE(rx.our_brand_revenue, 0) AS our_brand_revenue,\n    ROUND(COALESCE(rx.our_brand_revenue, 0) / NULLIF(c.total_visits, 0), 2) AS revenue_per_visit\nFROM call_metrics c\nLEFT JOIN hcp_rx_summary rx ON c.physician_id = rx.physician_id", "relation_name": "PHARMA_DW_DEV.MARTS.mart_rep_effectiveness", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-05T23:28:41.966487Z", "completed_at": "2026-10-05T23:28:48.317013Z"}, {"name": "execute", "started_at": "2026-10-05T23:28:48.318541Z", "completed_at": "2026-10-05T23:28:48.318557Z"}], "thread_id": "main", "execution_time": 6.35207, "adapter_response": {}, "message": "elementary.on-run-end.0 passed", "failures": 0, "unique_id": "operation.elementary.elementary-on-run-end-0", "compiled": true, "compiled_code": "\n      \n      \n\n      \n        \n      \n\n      \n        \n      \n\n      \n\n      \n\n      \n        \n      \n\n      \n      \n        \n      \n  \n", "relation_name": null, "batch_results": null, "overload_results": null}], "elapsed_time": 22.274993896484375, "args": {"empty": false, "v2_parser": "dbt-core-experimental-parser parse", "show_all_deprecations": false, "use_v2_parser": false, "use_fast_test_edges": false, "require_source_and_semantic_model_names_without_spaces": false, "source_freshness_run_pro