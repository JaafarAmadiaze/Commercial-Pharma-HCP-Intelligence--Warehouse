,'monitors_runs','SUCCESS 1','success','model',0.4302546977996826,'2026-10-05T23:06:47.736627Z','2026-10-05T23:06:48.152266Z','2026-10-05T23:06:47.725248Z','2026-10-05T23:06:47.734596Z',1,False,'\n\nwith data_monitoring_metrics as (\n\n    select * from PHARMA_DW_DEV.ELEMENTARY.data_monitoring_metrics\n\n),\n\nmax_bucket_end as (\n\n    select full_table_name,\n           column_name,\n           metric_name,\n           metric_properties,\n           max(bucket_end) as last_bucket_end,\n           min(bucket_end) as first_bucket_end\n    from data_monitoring_metrics\n    group by 1,2,3,4\n\n)\n\nselect * from max_bucket_end',NULL,'01c7894a-0002-2774-0002-ceaa00078106','Thread-2 (worker)','view','{"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c7894a-0002-2774-0002-ceaa00078106"}'),('dfa8320b-eccf-4e72-978c-cd2ea5942fde.model.elementary.seed_run_results','model.elementary.seed_run_results','dfa8320b-eccf-4e72-978c-cd2ea5942fde','2026-10-05 23:06:53',
