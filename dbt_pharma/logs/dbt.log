,'mart_rep_effectiveness','SUCCESS 1969','success','model',2.2602741718292236,'2026-10-05T23:28:39.708994Z','2026-10-05T23:28:41.940780Z','2026-10-05T23:28:39.687422Z','2026-10-05T23:28:39.706339Z',1969,False,'\n\nWITH call_metrics AS (\n    SELECT\n        rep_id,\n        physician_id,\n        territory_id,\n        COUNT(call_id) AS total_visits,\n        SUM(samples_dropped_count) AS total_samples_provided,\n        AVG(call_sentiment_score) AS avg_sentiment_score,\n        MODE(doctor_barrier_category) AS most_frequent_barrier\n    FROM PHARMA_DW_DEV.MARTS.fact_field_calls\n    GROUP BY rep_id, physician_id, territory_id\n),\n\nhcp_rx_summary AS (\n    SELECT\n        physician_id,\n        SUM(CASE WHEN is_our_brand THEN trx_count ELSE 0 END) AS our_brand_total_trx,\n        SUM(CASE WHEN is_our_brand THEN total_gross_rx_value ELSE 0 END) AS our_brand_revenue\n    FROM PHARMA_DW_DEV.MARTS.fact_prescription_claims\n    GROUP BY physician_id\n)\n\nSELECT\n    c.rep_id,\n    c.territory_id,\n    c.physician_id,\n    c.total_visits,\n    c.total_samples_provided,\n    ROUND(c.avg_sentiment_score, 3) AS avg_sentiment_score,\n    c.most_frequent_barrier,\n    COALESCE(rx.our_brand_total_trx, 0) AS our_brand_total_trx,\n    COALESCE(rx.our_brand_revenue, 0) AS our_brand_revenue,\n    ROUND(COALESCE(rx.our_brand_revenue, 0) / NULLIF(c.total_visits, 0), 2) AS revenue_per_visit\nFROM call_metrics c\nLEFT JOIN hcp_rx_summary rx ON c.physician_id = rx.physician_id',NULL,'01c78960-0002-26b8-0002-ceaa0007152e','Thread-2 (worker)','table','{"_message": "SUCCESS 1969", "code": "SUCCESS", "rows_affected": 1969, "query_id": "01c78960-0002-26b8-0002-ceaa0007152e", "rows_inserted": 1969, "rows_deleted": 0, "rows_updated": 0, "rows_duplicates": 0}')
