    ('227851f8-c52c-4793-b54b-e16a2dec32b5.model.dbt_pharma.mart_rep_effectiveness','model.dbt_pharma.mart_rep_effectiveness','227851f8-c52c-4793-b54b-e16a2dec32b5','2026-10-05 23:28:46',
