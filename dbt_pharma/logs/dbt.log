         (MODEL_EXECUTION_ID,UNIQUE_ID,INVOCATION_ID,GENERATED_AT,CREATED_AT,NAME,MESSAGE,STATUS,RESOURCE_TYPE,EXECUTION_TIME,EXECUTE_STARTED_AT,EXECUTE_COMPLETED_AT,COMPILE_STARTED_AT,COMPILE_COMPLETED_AT,ROWS_AFFECTED,FULL_REFRESH,COMPILED_CODE,FAILURES,QUERY_ID,THREAD_ID,MATERIALIZATION,ADAPTER_RESPONSE) values
    ('27635605-1b6d-4b68-894d-4911d84b28ea.model.dbt_pharma.mart_hcp_deciles','model.dbt_pharma.mart_hcp_deciles','27635605-1b6d-4b68-894d-4911d84b28ea','2026-10-05 23:27:00',
  current_timestamp::timestamp
,'mart_hcp_deciles','SUCCESS 1500','success','model',6.147655487060547,'2026-10-05T23:26:48.124728Z','2026-10-05T23:26:54.120766Z','2026-10-05T23:26:47.994912Z','2026-10-05T23:26:48.091798Z',1500,False,'\n\nWITH hcp_volumes AS (\n    SELECT\n        f.physician_id,\n        p.territory_id,\n        p.specialty,\n        d.therapeutic_class,\n        SUM(f.trx_count) AS total_trx,\n        SUM(f.nrx_count) AS total_nrx,\n        SUM(f.total_gross_rx_value) AS total_rx_revenue,\n        SUM(CASE WHEN f.is_our_brand THEN f.trx_count ELSE 0 END) AS our_brand_trx\n    FROM PHARMA_DW_DEV.MARTS.fact_prescription_claims f\n    JOIN PHARMA_DW_DEV.MARTS.dim_physician p ON f.physician_id = p.physician_id\n    JOIN PHARMA_DW_DEV.MARTS.dim_product d ON f.product_id = d.product_id\n    GROUP BY f.physician_id, p.territory_id, p.specialty, d.therapeutic_class\n),\n\nranked_hcps AS (\n    SELECT\n        *,\n        NTILE(10) OVER (\n            PARTITION BY therapeutic_class \n            ORDER BY total_trx ASC\n        ) AS hcp_decile\n    FROM hcp_volumes\n)\n\nSELECT\n    physician_id,\n    territory_id,\n    specialty,\n    therapeutic_class,\n    total_trx,\n    total_nrx,\n    our_brand_trx,\n    total_rx_revenue,\n    hcp_decile,\n    CASE \n        WHEN hcp_decile >= 8 THEN \'Tier 1 (High Priority)\'\n        WHEN hcp_decile >= 5 THEN \'Tier 2 (Medium Priority)\'\n        ELSE \'Tier 3 (Low Priority)\'\n    END AS commercial_tier\nFROM ranked_hcps',NULL,'01c7895e-0002-2770-0002-ceaa00076512','Thread-3 (worker)','table','{"_message": "SUCCESS 1500", "code": "SUCCESS", "rows_affected": 1500, "query_id": "01c7895e-0002-2770-0002-ceaa00076512", "rows_inserted": 1500, "rows_deleted": 0, "rows_updated": 0, "rows_duplicates": 0}'),('27635605-1b6d-4b68-894d-4911d84b28ea.model.dbt_pharma.mart_brand_performance','model.dbt_pharma.mart_brand_performance','27635605-1b6d-4b68-894d-4911d84b28ea','2026-10-05 23:27:00',
  current_timestamp::timestamp
,'mart_brand_performance','SUCCESS 386','success','model',6.15807843208313,'2026-10-05T23:26:48.021489Z','2026-10-05T23:26:54.128892Z','2026-10-05T23:26:47.982285Z','2026-10-05T23:26:48.019392Z',386,False,'\n\nWITH monthly_claims AS (\n    SELECT\n        DATE_TRUNC(\'month\', f.claim_date) AS claim_month,\n        f.territory_id,\n        d.therapeutic_class,\n        d.brand_name,\n        d.is_our_brand,\n        SUM(f.trx_count) AS brand_trx,\n        SUM(f.nrx_count) AS brand_nrx,\n        SUM(f.total_gross_rx_value) AS brand_revenue\n    FROM PHARMA_DW_DEV.MARTS.fact_prescription_claims f\n    JOIN PHARMA_DW_DEV.MARTS.dim_product d ON f.product_id = d.product_id\n    GROUP BY 1, 2, 3, 4, 5\n),\n\nclass_totals AS (\n    SELECT\n        claim_month,\n        territory_id,\n        therapeutic_class,\n        SUM(brand_trx) AS total_class_trx\n    FROM monthly_claims\n    GROUP BY 1, 2, 3\n)\n\nSELECT\n    m.claim_month,\n    m.territory_id,\n    m.therapeutic_class,\n    m.brand_name,\n    m.is_our_brand,\n    m.brand_trx,\n    m.brand_nrx,\n    m.brand_revenue,\n    t.total_class_trx,\n    ROUND((m.brand_trx / NULLIF(t.total_class_trx, 0)) * 100, 2) AS market_share_percentage,\n    ROUND((m.brand_nrx / NULLIF(m.brand_trx, 0)) * 100, 2) AS nrx_conversion_rate\nFROM monthly_claims m\nJOIN class_totals t \n    ON m.claim_month = t.claim_month\n    AND m.territory_id = t.territory_id\n    AND m.therapeutic_class = t.therapeutic_class',NULL,'01c7895e-0002-26b8-0002-ceaa00071506','Thread-2 (worker)','table','{"_message": "SUCCESS 386", "code": "SUCCESS", "rows_affected": 386, "query_id": "01c7895e-0002-26b8-0002-ceaa00071506", "rows_inserted": 386, "rows_deleted": 0, "rows_updated": 0, "rows_duplicates": 0}'),('27635605-1b6d-4b68-894d-4911d84b28ea.model.dbt_pharma.mart_rep_effectiveness','model.dbt_pharma.mart_rep_effectiveness','27635605-1b6d-4b68-894d-4911d84b28ea','2026-10-05 23:27:00',
  current_timestamp::timestamp
,'mart_rep_effectiveness','Database Error in model mart_rep_effectiveness (models\\marts\\mart_rep_effectiveness.sql)\n  002070 (42601): SQL compilation error:\n  Function MODE does not support WITHIN GROUP clause.\n  compiled code at target\\run\\dbt_pharma\\models\\marts\\mart_rep_effectiveness.sql','error','model',7.947173357009888,'2026-10-05T23:26:48.198459Z','2026-10-05T23:26:55.898760Z','2026-10-05T23:26:48.006360Z','2026-10-05T23:26:48.122155Z',NULL,False,'\n\nWITH call_metrics AS (\n    SELECT\n        rep_id,\n        physician_id,\n        territory_id,\n        COUNT(call_id) AS total_visits,\n        SUM(samples_dropped_count) AS total_samples_provided,\n        AVG(call_sentiment_score) AS avg_sentiment_score,\n        MODE() WITHIN GROUP (ORDER BY doctor_barrier_category) AS most_frequent_barrier\n    FROM PHARMA_DW_DEV.MARTS.fact_field_calls\n    GROUP BY rep_id, physician_id, territory_id\n),\n\nhcp_rx_summary AS (\n    SELECT\n        physician_id,\n        SUM(CASE WHEN is_our_brand THEN trx_count ELSE 0 END) AS our_brand_total_trx,\n        SUM(CASE WHEN is_our_brand THEN total_gross_rx_value ELSE 0 END) AS our_brand_revenue\n    FROM PHARMA_DW_DEV.MARTS.fact_prescription_claims\n    GROUP BY physician_id\n)\n\nSELECT\n    c.rep_id,\n    c.territory_id,\n    c.physician_id,\n    c.total_visits,\n    c.total_samples_provided,\n    ROUND(c.avg_sentiment_score, 3) AS avg_sentiment_score,\n    c.most_frequent_barrier,\n    COALESCE(rx.our_brand_total_trx, 0) AS our_brand_total_trx,\n    COALESCE(rx.our_brand_revenue, 0) AS our_brand_revenue,\n    ROUND(COALESCE(rx.our_brand_revenue, 0) / NULLIF(c.total_visits, 0), 2) AS revenue_per_visit\nFROM call_metrics c\nLEFT JOIN hcp_rx_summary rx ON c.physician_id = rx.physician_id',NULL,NULL,'Thread-4 (worker)','table','{}')
